{
  "name": "gtv-desktop-remote",
  "productName": "GTV Remote",
  "version": "1.6.3",
  "description": "macOS-first desktop remote for Google TV and Android TV",
  "packageManager": "yarn@4.16.0",
  "main": "dist-electron/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/usrivastava92/gtv-desktop-remote.git"
  },
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main/main.js file:dist-electron/main/preload.js && electron .\"",
    "dev:capture": "GTV_CAPTURE=1 concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main/main.js file:dist-electron/main/preload.js && GTV_CAPTURE=1 electron .\"",
    "clean": "rm -rf dist dist-electron coverage release",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "rebuild": "yarn clean && yarn build",
    "pack": "yarn build && electron-builder --dir --publish never",
    "dist:mac": "yarn build && electron-builder --mac dmg zip --publish never",
    "homebrew:cask": "node scripts/render-homebrew-cask.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "reset:app": "node scripts/reset-app-state.mjs",
    "reset:app:dry-run": "node scripts/reset-app-state.mjs --dry-run",
    "release": "bin/release",
    "release:dry-run": "bin/release --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.utkarsh.gtvdesktopremote",
    "productName": "GTV Remote",
    "directories": {
      "buildResources": "assets/icons",
      "output": "release"
    },
    "icon": "taskbar-icon.icns",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "assets/**/*",
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "taskbar-icon.icns",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "icon": "taskbar-icon.icns"
    }
  },
  "dependencies": {
    "@librecontrol/google-tv": "^1.0.0",
    "node-forge": "^1.3.1",
    "protobufjs": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.1.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.0"
  }
}
